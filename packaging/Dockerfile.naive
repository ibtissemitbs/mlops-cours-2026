FROM python:3.12

WORKDIR /app

COPY . /app

RUN pip install --no-cache-dir \
    fastapi==0.142.2 \
    "uvicorn[standard]" \
    onnxruntime==1.30.0 \
    numpy \
    pandas \
    pyyaml

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "app.serve:app", "--app-dir", "packaging", "--host", "0.0.0.0", "--port", "8000"]
